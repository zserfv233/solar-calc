---
import { defaultsVic } from '../lib/data';
import { dictionaries, type Language } from '../lib/calculator-ui';
import { sourcesById } from '../lib/sources';
import '../styles/calculator.css';

interface Props { lang: Language }
const { lang } = Astro.props;
const t = dictionaries[lang];
const d = defaultsVic.values;
const a = d.assumptions_from_plan;
const quotes = d.typical_quotes_after_rebate;
const tariffs = d.vdo_flat_2026_27;
const sources = sourcesById();
const sourceItems = [
  ['vdo', 'tariffSource'], ['usage', 'usageSource'], ['feedIn', 'feedInSource'],
  ['solarQuote', 'solarQuoteSource'], ['batteryQuote', 'batteryQuoteSource'],
  ['stcPrice', 'stcPriceSource'], ['batteryPolicy', 'batteryPolicySource'],
  ['seasonal', 'seasonalSource'], ['batteryWarranty', 'batteryModelSource'], ['batteryLife', 'batteryLifeSource'],
] as const;
const shareLabel = (share: number) => new Intl.NumberFormat(lang === 'zh' ? 'zh-CN' : 'en-AU', { style: 'percent' }).format(share);
---
<!doctype html>
<html lang={lang === 'zh' ? 'zh-CN' : 'en-AU'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={t.intro} />
    <title>{t.title}</title>
  </head>
  <body data-language={lang}>
    <header class="site-header">
      <a class="brand" href={`/${lang}/`} aria-label="solar-calc"><svg width="32" height="32" viewBox="0 0 32 32" aria-hidden="true"><path d="M4 24h24M8 20a8 8 0 0 1 16 0M16 4v4M5 9l3 3M27 9l-3 3" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>solar<span>calc</span></a>
      <nav aria-label={t.calculator}><a href="#defaults">{t.sourcesTitle}</a><a id="language-switch" lang={lang === 'zh' ? 'en' : 'zh'} href={lang === 'zh' ? '/en/' : '/zh/'}>{t.languageSwitch}<span aria-hidden="true"> ↗</span></a></nav>
    </header>
    <main>
      <section class="hero">
        <p class="eyebrow">{t.eyebrow}</p><h1>{t.calculatorTitle}</h1><p class="intro">{t.intro}</p>
        <p class="privacy"><span aria-hidden="true"></span>{t.privacy}</p>
      </section>
      <div class="workspace">
        <form id="calculator-form" novalidate>
          <fieldset class="plan-picker"><legend>{t.plan}</legend>
            <div class="plan-options">
              <label><input type="radio" name="plan" value="solar_only" checked /><span>{t.solarOnly}</span></label>
              <label><input type="radio" name="plan" value="solar_battery" /><span>{t.solarBattery}</span></label>
              <label><input type="radio" name="plan" value="battery_only" /><span>{t.batteryOnly}</span></label>
            </div>
          </fieldset>
          <fieldset class="form-section"><legend><span class="step-number">01</span>{t.homeSection}</legend>
            <div class="fields">
              <label>{t.postcode}<input name="postcode" inputmode="numeric" autocomplete="postal-code" pattern="[0-9]{4}" maxlength="4" required aria-describedby="postcode-hint" /><small id="postcode-hint">{t.postcodeHint}</small></label>
              <label>{t.installationDate}<input type="date" name="installationDate" required /></label>
              <label class="wide">{t.distributor}<select name="distributor">{Object.keys(tariffs).map((name) => <option value={name} selected={name === d.default_distributor}>{name}</option>)}</select><small id="supply-charge"></small></label>
              <label>{t.importTariff}<input name="importTariffCents" type="number" min="0" step="any" value={tariffs[d.default_distributor].usage_c_per_kwh} required /></label>
              <label>{t.feedInTariff}<input name="feedInTariffCents" type="number" min="0" step="any" value={d.feed_in_tariff_c_per_kwh} required /><small>{t.feedInHint}</small></label>
              <label class="wide">{t.usageMode}<select name="usageMode"><option value="annual">{t.annualMode}</option><option value="bill">{t.billMode}</option></select></label>
              <label class="wide" data-annual-field>{t.annualUsage}<input name="annualUsageKwh" type="number" min="0" step="any" value={d.annual_usage_kwh} required /></label>
              <div class="wide fields" data-bill-fields hidden>
                <label>{t.billTotal}<input name="billTotal" type="number" min="0" step="any" disabled required /></label>
                <label>{t.billDays}<input name="billDays" type="number" min="1" step="1" disabled required /></label>
                <p class="hint wide">{t.billHint}</p>
              </div>
              <label class="wide">{t.daytimeShare}<select name="daytimeShare"><option value="away">{t.away} · {shareLabel(a.daytime_share.away)}</option><option value="partly_home">{t.partlyHome} · {shareLabel(a.daytime_share.partly_home)}</option><option value="mostly_home">{t.mostlyHome} · {shareLabel(a.daytime_share.mostly_home)}</option></select></label>
            </div>
          </fieldset>
          <fieldset class="form-section"><legend><span class="step-number">02</span>{t.systemSection}</legend>
            <div class="fields">
              <label class="wide" data-new-solar>{t.solarKw}<input name="solarKw" type="number" min="0" step="any" value={a.solar_size_kw} required /></label>
              <label class="wide" data-existing-solar hidden>{t.existingSolarKw}<input name="existingSolarKw" type="number" min="0" step="any" value={a.existing_solar_size_kw} disabled required /></label>
              <label class="wide" data-battery-field hidden>{t.batteryKwh}<input name="batteryKwh" type="number" min="0" step="any" value={a.battery_usable_kwh} disabled required /><small>{t.usableHint}</small></label>
            </div>
          </fieldset>
          <fieldset class="form-section"><legend><span class="step-number">03</span>{t.quoteSection}</legend>
            <div class="fields">
              <label class="wide" data-solar-quote>{t.solarQuote}<input name="solarQuote" type="number" min="0" step="any" value={quotes.solar_6_6kw_dollars} required /></label>
              <label class="wide" data-battery-quote hidden>{t.batteryQuote}<input name="batteryQuote" type="number" min="0" step="any" value={quotes.battery_10kwh_dollars} disabled required /></label>
              <label class="wide">{t.quoteIncludesRebate}<select name="quoteIncludesRebate"><option value="yes">{t.yesRebate}</option><option value="no">{t.noRebate}</option></select></label>
              <label class="wide">{t.stcPrice}<input name="stcPrice" type="number" min="0" step="any" value={d.stc_price_dollars} required /></label>
              <p class="hint wide">{t.quoteHint}</p>
            </div>
          </fieldset>
          <div id="form-error" class="form-error" role="alert" hidden></div>
          <button class="calculate" type="submit" disabled>{t.calculate}<span aria-hidden="true">→</span></button>
          <noscript><p class="notice">{t.noScript}</p></noscript>
        </form>
        <aside class="guide">
          <div class="sun-mark" aria-hidden="true"><span></span></div>
          <h2>{t.emptyTitle}</h2><p>{t.emptyText}</p><div class="guide-divider"></div><p class="hint">{t.modelNote}</p>
          <details id="defaults" class="defaults"><summary>{t.defaultsTitle}</summary>
            {sourceItems.map(([id, key]) => <p><a data-source-id={id} href={sources[id].url} target="_blank" rel="noreferrer">{t[key]}</a><small>{t.checkedOn.replace('{date}', sources[id].last_checked)}</small></p>)}
            <p class="hint">{t.assumptionsSource}<small>{t.checkedOn.replace('{date}', defaultsVic.last_checked)}</small></p>
          </details>
        </aside>
      </div>
      <section id="results" class="results" hidden aria-labelledby="results-heading">
        <div class="section-heading"><p class="eyebrow">SOLAR CALC</p><h2 id="results-heading" tabindex="-1">{t.resultsTitle}</h2></div>
        <div id="result-content"></div>
      </section>
    </main>
    <footer><a href={`/${lang}/`}>solar-calc</a><p>{t.privacy}</p><p>v0.1</p></footer>
    <script>
      import '../scripts/calculator';
    </script>
  </body>
</html>
