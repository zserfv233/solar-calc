      import { readLanguage } from '../lib/language';
      let storage: Storage | undefined;
      try { storage = window.localStorage; } catch { /* 禁用存储时按浏览器语言选择。 */ }
      window.location.replace(`/${readLanguage(navigator.language, storage)}/`);
